# Public hostnames (DNS A/AAAA records must point at this host)
DOMAIN=datapod.example.com
AUTH_DOMAIN=auth.datapod.example.com

# From the OIDC client created in Pocket ID (callback: https://DOMAIN/auth/callback)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Generate each with: openssl rand -base64 32
# Changing JWT_SIGNING_KEY logs every connector out.
JWT_SIGNING_KEY=
POCKET_ID_ENCRYPTION_KEY=
